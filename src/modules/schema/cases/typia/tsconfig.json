{
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "src",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ],
    "strictNullChecks": true,
    "outDir": "build",
    "skipLibCheck": true
  },
  "include": ["src/index.ts"]
}
